# ==========================================
# Orion Environment Configuration Template
# Copy this file to .env and fill in your values
# ==========================================

# --- API Keys ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
SERP_API_KEY=your_serp_api_key_here

# --- LLM Provider & Model Configuration ---
# Options: groq (cloud, ultra-fast <0.3s) | ollama (local offline)
LLM_PROVIDER=groq

# Default model:
# For Groq: llama-3.3-70b-versatile | llama-3.1-8b-instant
# For Ollama: qwen3.5:4b | qwen2.5:1.5b | llama3.2:1b
DEFAULT_MODEL=llama-3.3-70b-versatile

# Ollama local endpoint (used if LLM_PROVIDER=ollama or as fallback)
OLLAMA_URL=http://localhost:11434/api/chat

# --- Speech-to-Text (STT) Configuration ---
# Options: groq (cloud, <0.25s) | local (on-device faster-whisper)
STT_PROVIDER=groq

# Groq STT Model (default: whisper-large-v3-turbo)
GROQ_STT_MODEL=whisper-large-v3-turbo

# Local Whisper STT Settings (used if STT_PROVIDER=local or offline fallback)
# Models: tiny.en, base.en, small.en, medium.en, large-v3
STT_MODEL_SIZE=base.en
STT_BEAM_SIZE=2
STT_LOCAL_FILES_ONLY=false

# --- Search Provider Configuration ---
# Options: duckduckgo | tavily | serp | mock
SEARCH_PROVIDER=duckduckgo

# --- Text-to-Speech (TTS) Configuration ---
# Options: kokoro | edge_tts | piper
TTS_PROVIDER=kokoro

# Kokoro TTS Settings
# Presets: orion (default, young & crisp) | orion_crisp | orion_young_tech | orion_dynamic | orion_lewis | orion_classic
# Or custom blend formula: "0.65*bm_lewis+0.35*bm_daniel"
# Or single voice: bm_lewis, bm_daniel, bm_fable, am_adam, af_heart
TTS_VOICE=orion
TTS_LANG=b
TTS_SPEED=1.2            # Speech speed: 1.0 is standard; 1.15 - 1.25 is natural, crisp, conversational speed

# Piper TTS Settings
PIPER_MODEL_PATH=voice/models/orion.onnx
# PIPER_CONFIG_PATH=voice/models/orion.onnx.json
PIPER_LENGTH_SCALE=1.0
PIPER_NOISE_SCALE=0.667
PIPER_NOISE_W=0.8

# EdgeTTS Settings
# EdgeTTS voices: en-GB-RyanNeural, en-US-EmmaNeural, en-US-GuyNeural, etc.
